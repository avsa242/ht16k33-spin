{
----------------------------------------------------------------------------------------------------
    Filename:       HT16K33-7SegDemo.spin2
    Description:    Demo of the HT16K33 segment driver
        * 7-segment
    Author:         Jesse Burt
    Started:        Jul 25, 2025
    Updated:        Aug 1, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


OBJ

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    disp:   "display.led-seg.ht16k33" | SCL=24, SDA=26, I2C_FREQ=400_000, I2C_ADDR=%000, ...
                                        WIDTH=4, HEIGHT=1
    font:   "font.seg.adafruit-7seg"
    str:    "string"

    ' WIDTH, HEIGHT: number of digits/characters width and height the display has
    ' The demo is written to work best with a 4x1 display


PUB main() | i, t

    setup()

    repeat
        disp.clear()
        t := cnt
        repeat
            disp.pos_xy(0,0)
            disp.str(@"12:34")
            disp.show()
            waitms(500)
            disp.str(@"1234")
            disp.show()
            waitms(500)
            if ( abs(cnt-t) > (clkfreq*5) )
                quit

        repeat
            repeat i from 0 to 9999
                disp.clear()
                disp.pos_xy(0, 0)
                disp.printf(@"%4d", i)
                disp.show()
            quit

        waitms(1000)

        disp.clear()
        disp.str(@"3.141")
        disp.show()
        waitms(1000)
        disp.clear()
        disp.str(@"31.41")
        disp.show()
        disp.clear()
        waitms(1000)
        disp.str(@"314.1")
        disp.show()
        waitms(1000)
        disp.clear()
        disp.str(@"3141.")
        disp.show()
        waitms(1000)

PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( disp.start() )
        ser.strln(@"HT16K33 driver started")
        disp.defaults()
    else
        ser.str(@"HT16K33 driver failed to start - halting")
        repeat

    disp.set_font( font.setup() )


DAT
